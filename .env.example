# Railway OAuth application credentials.
# Create the app under your Railway workspace's Developer settings, and register ONE
# redirect URI per domain the app is reached on (they must match exactly, including
# scheme and trailing path):
#   http://localhost:3000/api/auth/callback
#   https://<your-deployment>.up.railway.app/api/auth/callback
# The deployed instance at https://trains.schupke.io registers
#   https://trains.schupke.io/api/auth/callback
# Sign-in follows the domain the request arrived on, so a domain with no callback
# registered is rejected by Railway rather than by this app.
RAILWAY_CLIENT_ID=
RAILWAY_CLIENT_SECRET=

# Encrypts the session cookie. Any high-entropy string, 32+ chars.
#   openssl rand -base64 32
SESSION_SECRET=

# Optional. The app serves whatever domain the request arrived on, so a custom domain
# needs nothing set here. This overrides that, and is what a request carrying no usable
# Host header falls back to. https unless it points at localhost — every cookie decision
# reads the origin, and an http one downgrades the session to a cleartext, unprefixed
# cookie. Locally there is no proxy in front, so the value below is what dev serves.
APP_URL=http://localhost:3000

# Optional allowlist of origins this app will answer as, comma-separated. Unset means
# any host the edge reports, which is what lets a new custom domain need no configuration.
#
# Setting it does NOT implicitly allow APP_URL or the generated *.up.railway.app domain —
# an allowlist with a hidden extra entry is not an allowlist. List every domain you serve.
# Each one still needs its own callback registered on the OAuth app; this decides what the
# app will answer as, not what Railway will redirect to.
# APP_ORIGINS=https://trains.schupke.io,https://<your-deployment>.up.railway.app

# Ownership marker. Services this app creates are named "<prefix><name>", and only
# services carrying the prefix can be destroyed from the UI. Changing it after
# containers exist orphans them (they stay in Railway, but become read-only here).
MANAGED_PREFIX=spun-

# How often the server asks Railway whether the selected project changed, in ms.
# Defaults to 15000, floored at 1000. One request per tick per *visible* tab — the 15s
# default is 240/hour against Hobby's documented 1000, and zero for a tab nobody is
# looking at. Raise it on a tight rate limit; lower it on a plan with headroom.
# WATCH_POLL_MS=15000

# How stale the CPU/memory/uptime readouts may get before the watcher asks the tab to
# re-render, in ms. Metrics are read on the render rather than polled, so this is the only
# thing that refreshes them while a project sits unchanged.
#
# Defaults to 120000. At that value a visible dashboard forces at most 30 renders an hour at
# four Railway requests each — 120/hour on top of the watcher's 240, against Hobby's 1000.
# Halving it doubles that half. Only visible tabs count, and only environments with
# something actually running.
#
# Set to 0 to turn the readouts off entirely: no nudge, no metrics request, nothing rendered.
# Any other value is floored at 1000.
# METRICS_POLL_MS=120000

# Log verbosity: silent | error | warn | info | debug | trace.
# Defaults to info in production and debug elsewhere. An unrecognised value clamps to
# that default rather than failing — a logger must never be the component that refuses
# to boot.
#
# Read straight from the environment rather than through src/env.ts, which is the one
# deliberate exception to that rule: /api/health exists in order to log env() failing,
# and a logger that called env() could not report that failure. See ADR-9.
# LOG_LEVEL=info

# ---- Optional: point the app at a stand-in Railway ----
# Only the end-to-end suite sets these (see e2e/fixtures/fake-railway). They default
# to Railway's production endpoints, and nothing overrides them in a real deployment.
# RAILWAY_ISSUER=https://backboard.railway.com
# RAILWAY_API_URL=https://backboard.railway.com/graphql/v2
# RAILWAY_WS_URL=wss://backboard.railway.com/graphql/v2

# ---- Optional: point the image existence check at a stand-in registry ----
# Same purpose as the three above, for the check that asks Docker Hub, ghcr.io or quay.io
# whether an image reference exists. Only the end-to-end suite sets it; unset means the
# real registries, which is what src/lib/registry/registries.ts holds.
#
# It does not widen the allowlist — the registry is still resolved from the reference
# against those same three, and anything else is still refused without a request. And
# unlike RAILWAY_WS_URL, the requests it redirects carry no credential at all: no bearer,
# no cookie, no body. A wrong value is an app that says nothing about images.
# REGISTRY_PROBE_URL=http://localhost:4010
