{
  "name": "railway",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:pretty": "next dev | pino-pretty",
    "build": "next build",
    "postbuild": "node --no-warnings --experimental-strip-types scripts/pack-standalone.ts",
    "start": "node .next/standalone/server.js",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:schema": "node --no-warnings --experimental-strip-types scripts/verify-schema.ts",
    "schema:pull": "node --no-warnings --experimental-strip-types scripts/pull-schema.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "pnpm codegen && git diff --exit-code src/lib/railway/graphql.generated.ts",
    "cursor:generate": "node --no-warnings --experimental-strip-types scripts/generate-cursor-rules.ts",
    "cursor:check": "node --no-warnings --experimental-strip-types scripts/generate-cursor-rules.ts --check",
    "probe:projects": "tsx --env-file-if-exists=.env scripts/probe-projects.ts",
    "probe:deployment": "tsx --env-file-if-exists=.env scripts/probe-deployment.ts",
    "probe:deployments": "tsx --env-file-if-exists=.env scripts/probe-deployments.ts",
    "probe:logs": "tsx --env-file-if-exists=.env scripts/probe-logs.ts",
    "probe:metrics": "tsx --env-file-if-exists=.env scripts/probe-metrics.ts",
    "probe:subscription": "tsx --env-file-if-exists=.env scripts/probe-subscription.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm codegen:check && pnpm cursor:check && pnpm knip && pnpm test:coverage",
    "size": "node --no-warnings --experimental-strip-types scripts/check-bundle-budget.ts",
    "knip": "knip",
    "lh:auth": "node --no-warnings --experimental-strip-types scripts/lh-auth.ts",
    "serve:e2e": "node --no-warnings --experimental-strip-types scripts/serve-e2e.ts",
    "lh:collect": "lhci autorun",
    "lighthouse": "node --no-warnings --experimental-strip-types scripts/lighthouse.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql-ws": "^6.2.1",
    "jose": "^6.2.10",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "next-intl": "^4.13.7",
    "openid-client": "^6.8.7",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "graphql": "^16.14.2",
    "jsdom": "^30.0.1",
    "knip": "^6.32.1",
    "msw": "^2.15.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22.x"
  }
}
