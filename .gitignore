# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# but the template is meant to be committed
!.env.example

# playwright
/playwright-report
/test-results
/coverage

# Lighthouse. The session cookie lh-auth.ts mints lives inside .lighthouseci/, so one
# entry covers it; the old root-level /.lighthouse-cookie is kept so a tree that still
# has one from a previous run does not start showing it as untracked.
/.lighthouseci
/.lighthouse-cookie
